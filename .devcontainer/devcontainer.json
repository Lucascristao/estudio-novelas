{
  "name": "Estúdio de Novelas",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "forwardPorts": [4173],
  "portsAttributes": {
    "4173": {
      "label": "Estúdio de Novelas",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg && pip install edge-tts && npm install && npm run build",
  "postStartCommand": "npm start"
}
